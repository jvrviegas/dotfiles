import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { Type } from "typebox";

const DEFAULT_MAX_CHARS = 12000;
const MAX_ALLOWED_CHARS = 50000;

function clampMaxChars(value: unknown): number {
	const n = typeof value === "number" && Number.isFinite(value) ? Math.floor(value) : DEFAULT_MAX_CHARS;
	return Math.max(1000, Math.min(MAX_ALLOWED_CHARS, n));
}

function decodeHtml(input: string): string {
	return input
		.replace(/&amp;/g, "&")
		.replace(/&lt;/g, "<")
		.replace(/&gt;/g, ">")
		.replace(/&quot;/g, '"')
		.replace(/&#39;/g, "'")
		.replace(/&#x27;/g, "'")
		.replace(/&#x2F;/g, "/")
		.replace(/&#(\d+);/g, (_m, n) => String.fromCharCode(Number(n)))
		.replace(/&#x([0-9a-fA-F]+);/g, (_m, n) => String.fromCharCode(parseInt(n, 16)));
}

function stripHtml(html: string): string {
	return decodeHtml(
		html
			.replace(/<script[\s\S]*?<\/script>/gi, " ")
			.replace(/<style[\s\S]*?<\/style>/gi, " ")
			.replace(/<noscript[\s\S]*?<\/noscript>/gi, " ")
			.replace(/<\/(p|div|section|article|header|footer|main|li|h[1-6]|br|tr)>/gi, "\n")
			.replace(/<[^>]+>/g, " ")
	)
		.replace(/[ \t\r\f\v]+/g, " ")
		.replace(/\n\s+/g, "\n")
		.replace(/\n{3,}/g, "\n\n")
		.trim();
}

function normalizeDuckDuckGoUrl(rawHref: string): string {
	const decoded = decodeHtml(rawHref);
	try {
		const url = new URL(decoded, "https://duckduckgo.com");
		const uddg = url.searchParams.get("uddg");
		if (uddg) return decodeURIComponent(uddg);
		return url.toString();
	} catch {
		return decoded;
	}
}

function extractDuckDuckGoResults(html: string, maxResults: number) {
	const results: Array<{ title: string; url: string; snippet?: string }> = [];
	const anchorRe = /<a[^>]+class="result__a"[^>]+href="([^"]+)"[^>]*>([\s\S]*?)<\/a>/gi;
	let match: RegExpExecArray | null;

	while ((match = anchorRe.exec(html)) && results.length < maxResults) {
		const url = normalizeDuckDuckGoUrl(match[1]);
		const title = stripHtml(match[2]);
		if (!title || !url) continue;

		const after = html.slice(anchorRe.lastIndex, anchorRe.lastIndex + 1200);
		const snippetMatch = after.match(/<a[^>]+class="result__snippet"[^>]*>([\s\S]*?)<\/a>|<div[^>]+class="result__snippet"[^>]*>([\s\S]*?)<\/div>/i);
		const snippet = snippetMatch ? stripHtml(snippetMatch[1] ?? snippetMatch[2] ?? "") : undefined;
		results.push({ title, url, ...(snippet ? { snippet } : {}) });
	}

	return results;
}

async function fetchText(url: string, signal?: AbortSignal): Promise<{ text: string; status: number; finalUrl: string; contentType: string | null }> {
	const res = await fetch(url, {
		signal,
		headers: {
			"user-agent": "pi-internet-browse/1.0 (+https://github.com/earendil-works/pi-coding-agent)",
			accept: "text/html,application/xhtml+xml,application/xml;q=0.9,text/plain;q=0.8,*/*;q=0.5",
		},
	});

	const text = await res.text();
	return {
		text,
		status: res.status,
		finalUrl: res.url,
		contentType: res.headers.get("content-type"),
	};
}

export default function internetBrowseExtension(pi: ExtensionAPI) {
	pi.registerTool({
		name: "web_fetch",
		label: "Web Fetch",
		description: "Fetch a public URL from the internet and return readable text content.",
		promptSnippet: "Fetch public URLs and extract readable text from HTML or plain text pages",
		promptGuidelines: [
			"Use web_fetch when the user asks to read, inspect, summarize, or cite a specific public URL.",
			"Use web_fetch only for public internet content; do not send secrets, local files, or private credentials.",
		],
		parameters: Type.Object({
			url: Type.String({ description: "Public http(s) URL to fetch" }),
			maxChars: Type.Optional(Type.Number({ description: "Maximum characters to return, 1000-50000. Default 12000." })),
		}),
		async execute(_toolCallId, params, signal) {
			const target = new URL(params.url);
			if (target.protocol !== "http:" && target.protocol !== "https:") {
				throw new Error("web_fetch only supports http(s) URLs");
			}

			const maxChars = clampMaxChars(params.maxChars);
			const { text, status, finalUrl, contentType } = await fetchText(target.toString(), signal);
			const readable = contentType?.includes("text/html") ? stripHtml(text) : text.trim();
			const truncated = readable.length > maxChars;
			const output = truncated ? `${readable.slice(0, maxChars)}\n\n[truncated: ${readable.length - maxChars} chars omitted]` : readable;

			return {
				content: [{ type: "text", text: output || "[empty response]" }],
				details: { url: target.toString(), finalUrl, status, contentType, truncated, length: readable.length },
			};
		},
	});

	pi.registerTool({
		name: "web_search",
		label: "Web Search",
		description: "Search the public web using DuckDuckGo HTML results and return titles, URLs, and snippets.",
		promptSnippet: "Search public web for current info, then use web_fetch on relevant results when needed",
		promptGuidelines: [
			"Use web_search when current public internet info is needed or user asks to browse/search the web.",
			"After web_search, use web_fetch on relevant result URLs before making detailed claims from page contents.",
		],
		parameters: Type.Object({
			query: Type.String({ description: "Search query" }),
			maxResults: Type.Optional(Type.Number({ description: "Maximum results to return, 1-10. Default 5." })),
		}),
		async execute(_toolCallId, params, signal) {
			const maxResults = Math.max(1, Math.min(10, Math.floor(params.maxResults ?? 5)));
			const searchUrl = `https://html.duckduckgo.com/html/?q=${encodeURIComponent(params.query)}`;
			const { text, status, finalUrl } = await fetchText(searchUrl, signal);
			const results = extractDuckDuckGoResults(text, maxResults);

			const body = results.length
				? results
						.map((r, i) => `${i + 1}. ${r.title}\n${r.url}${r.snippet ? `\n${r.snippet}` : ""}`)
						.join("\n\n")
				: "No results parsed. Try a different query or use web_fetch on a known URL.";

			return {
				content: [{ type: "text", text: body }],
				details: { query: params.query, searchUrl, finalUrl, status, results },
			};
		},
	});

	pi.registerCommand("internet", {
		description: "Show internet browsing tools status",
		handler: async (_args, ctx) => {
			ctx.ui.notify("Internet tools loaded: web_search, web_fetch. Use /reload if newly installed in running pi.", "info");
		},
	});
}
