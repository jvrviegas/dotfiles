{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "theme": "hollow-knight",
  "preview": "layouts/hallownest.svg",
  "background": {
    "image": "backgrounds/hollow-knight.png",
    "fit": "cover"
  },
  "terminal_padding": [
    14,
    12
  ],
  "terminal_opacity": 0.55,
  "divider": {
    "width": 1,
    "color": "#413466"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 256
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "agent-roster"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "background": "chrome",
          "content": {
            "mod": "tabs"
          }
        },
        {
          "id": "rule",
          "type": "column",
          "size": {
            "px": 2
          },
          "children": [],
          "background": {
            "gradient": [
              "#f0e6b8",
              "#f0e6b800"
            ],
            "angle": 90
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 10,
          "gap": 10,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 10,
                  "radius": 4,
                  "lone": true,
                  "background": "#0d0d14b3",
                  "border": {
                    "width": 1,
                    "color": "#2d2d42"
                  },
                  "focus": {
                    "width": 1,
                    "color": "#f0e6b8"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "background": "chrome",
          "content": {
            "mod": "workspace-status"
          }
        }
      ]
    }
  ]
}
