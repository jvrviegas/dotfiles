#!/usr/bin/env bash
# Reload the I2C-HID driver used by the built-in ELAN touchpad.
# Run from a terminal when the touchpad stops responding.
set -euo pipefail

if [[ $EUID -ne 0 ]]; then
  exec sudo -- "$0" "$@"
fi

modprobe -r i2c_hid_acpi i2c_hid
modprobe i2c_hid_acpi

echo 'Touchpad driver reloaded.'
